            "description": "יוצר פנייה ושומר את leadId. הגדירו clientEmail ככתובת שתוכלו לקבל אליה מייל; phone חייב להופיע ויכול להיות null.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_name\": \"Postman Test Client\",\n  \"client_email\": \"{{clientEmail}}\",\n  \"phone\": \"0501234567\",\n  \"service_type\": \"Renovation\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const data = pm.response.json();",
                  "  const value = data.id;",
                  "  if (value !== undefined && value !== null) pm.collectionVariables.set('leadId', String(value));",
                  "}"
                ]
              }
            }
          ],
          "response": []
        }
      ]
